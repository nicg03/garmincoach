{
  "name": "gepard-fit-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Capacitor shell for gepard.fit",
  "scripts": {
    "build": "node scripts/build-web.mjs",
    "sync": "npm run build && cap sync",
    "doctor": "cap doctor",
    "open:ios": "npm run sync && cap open ios",
    "open:android": "npm run sync && cap open android",
    "build:android": "npm run sync && cd android && ./gradlew bundleRelease",
    "check": "node scripts/verify-config.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "7.1.6",
    "@capacitor/android": "7.6.9",
    "@capacitor/app": "7.0.2",
    "@capacitor/browser": "7.0.2",
    "@capacitor/core": "7.6.9",
    "@capacitor/ios": "7.6.9",
    "@capacitor/keyboard": "7.0.3",
    "@capacitor/local-notifications": "7.0.3",
    "@capacitor/network": "7.0.2",
    "@capacitor/splash-screen": "7.0.3",
    "@capacitor/status-bar": "7.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.9",
    "esbuild": "0.25.10",
    "typescript": "5.9.3"
  }
}
